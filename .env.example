# ANALYSIS — full threat assessment
# Provider: openai (API key) or codex (ChatGPT sign-in).
ANALYSIS_PROVIDER=openai
# Model for this stage only. Blank: OpenAI gpt-6-luna; Codex's default model.
ANALYSIS_MODEL=
# Blank timeout: OpenAI 600000 ms; Codex 120000 ms. No triage inheritance.
ANALYSIS_TIMEOUT_MS=

# TRIAGE — optional filtering before full analysis
TRIAGE_ENABLED=false
# Independent of ANALYSIS_PROVIDER: openai (Decisions API) or codex.
TRIAGE_PROVIDER=openai
# Model for this stage only. Blank: OpenAI gpt-6-luna; Codex's default model.
TRIAGE_MODEL=
# Probabilities below this value skip full analysis. Range: 0 to 1.
TRIAGE_THRESHOLD=0.5
# Blank timeout: OpenAI 8000 ms; Codex 120000 ms. No analysis inheritance.
TRIAGE_TIMEOUT_MS=

# OPENAI CREDENTIALS — required only for selected, enabled OpenAI stages
# This key is never sent to Codex.
OPENAI_API_KEY=

# CODEX AUTHENTICATION — shared ChatGPT session, not model configuration
# Post-startup UI; required startup sign-in always opens this page when needed.
ENABLE_CODEX_AUTH_UI=
CODEX_LOGIN_TIMEOUT_MS=600000
# Private app-specific credential/data directory. Keep out of version control.
CODEX_HOME_DIR=.codex-alerts

# TELEGRAM
ENABLE_TELEGRAM=true
ENABLE_CHANNEL_POLLING=false
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here
TG_CHANNELS=
TG_SESSION=

# NOTIFICATIONS — optional Home Assistant webhooks
HA_WEBHOOK_URL=
HA_LOGS_WEBHOOK_URL=

# HTTP
PORT=4000
